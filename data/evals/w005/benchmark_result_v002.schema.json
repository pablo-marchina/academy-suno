{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy-suno.local/schemas/benchmark_result_v002.schema.json",
  "title": "Academy Suno benchmark result v002",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","methodology_id","run_id","sample_scope","evidence_class","baseline","candidates","observations","aggregates","hard_gates","pareto","statistics","decision","provenance"],
  "properties": {
    "schema_version": {"const":"benchmark-result-v002"},
    "methodology_id": {"const":"W005-BENCHMARK-METHODOLOGY-V002"},
    "run_id": {"type":"string","minLength":1},
    "sample_scope": {"enum":["REPRESENTATIVE_FOR_DECLARED_SCOPE","BOUNDED_DIAGNOSTIC_SAMPLE","MECHANICS_ONLY"]},
    "evidence_class": {"type":"string","minLength":1},
    "baseline": {"$ref":"#/$defs/system"},
    "candidates": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/system"}},
    "observations": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/observation"}},
    "aggregates": {"type":"array","minItems":2,"items":{"$ref":"#/$defs/aggregate"}},
    "hard_gates": {"type":"array","items":{"$ref":"#/$defs/gate"}},
    "pareto": {"$ref":"#/$defs/pareto"},
    "statistics": {"type":"array","items":{"$ref":"#/$defs/stat_result"}},
    "utility_view": {"anyOf":[{"type":"null"},{"$ref":"#/$defs/utility"}]},
    "decision": {"$ref":"#/$defs/decision"},
    "provenance": {"$ref":"#/$defs/provenance"}
  },
  "$defs": {
    "system": {
      "type":"object","additionalProperties":false,"required":["system_id","version"],
      "properties":{"system_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"provider":{"type":["string","null"]},"config_hash":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}}
    },
    "metric": {
      "type":"object","additionalProperties":false,
      "required":["metric_id","value","unit","direction","missingness","evidence_class","aggregation_level"],
      "properties": {
        "metric_id":{"type":"string","minLength":1},
        "value":{"type":["number","integer","boolean","string","null"]},
        "unit":{"type":"string","minLength":1},
        "direction":{"enum":["maximize","minimize","pass_fail","descriptive"]},
        "missingness":{"enum":["OBSERVED","NOT_APPLICABLE","NOT_COMPUTABLE","MISSING_CANDIDATE_OUTPUT","MEASUREMENT_FAILED","WITHHELD_HELD_OUT"]},
        "evidence_class":{"type":"string","minLength":1},
        "aggregation_level":{"enum":["observation","pair","source_group","slice","system","run"]}
      }
    },
    "observation": {
      "type":"object","additionalProperties":false,
      "required":["observation_id","evidence_item_id","source_group_id","stratum_id","system_id","generation_repeat_id","metrics","gate_states"],
      "properties": {
        "observation_id":{"type":"string","minLength":1},"evidence_item_id":{"type":"string","minLength":1},"source_group_id":{"type":"string","minLength":1},
        "audience":{"type":["string","null"]},"format":{"type":["string","null"]},"stratum_id":{"type":"string","minLength":1},"system_id":{"type":"string","minLength":1},"generation_repeat_id":{"type":"string","minLength":1},
        "metrics":{"type":"array","items":{"$ref":"#/$defs/metric"}},
        "gate_states":{"type":"object","additionalProperties":{"enum":["PASS","FAIL","REVIEW_REQUIRED","NOT_APPLICABLE","NOT_COMPUTABLE"]}}
      }
    },
    "aggregate": {
      "type":"object","additionalProperties":false,"required":["system_id","aggregation_level","n_observations","n_source_groups","coverage","eligible","metrics"],
      "properties":{"system_id":{"type":"string"},"aggregation_level":{"enum":["slice","system","run"]},"slice_id":{"type":["string","null"]},"n_observations":{"type":"integer","minimum":0},"n_source_groups":{"type":"integer","minimum":0},"coverage":{"type":"number","minimum":0,"maximum":1},"eligible":{"type":"boolean"},"metrics":{"type":"array","items":{"$ref":"#/$defs/metric"}}}
    },
    "gate": {
      "type":"object","additionalProperties":false,"required":["system_id","gate_id","state","evidence_refs"],
      "properties":{"system_id":{"type":"string"},"gate_id":{"type":"string"},"state":{"enum":["PASS","FAIL","REVIEW_REQUIRED","NOT_APPLICABLE","NOT_COMPUTABLE"]},"evidence_refs":{"type":"array","items":{"type":"string"}}}
    },
    "pareto": {
      "type":"object","additionalProperties":false,"required":["status","objective_ids","eligible_system_ids","point_frontier_system_ids","dominated_by"],
      "properties": {
        "status":{"enum":["COMPUTED","PARETO_NOT_COMPUTABLE"]},"objective_ids":{"type":"array","items":{"type":"string"}},"eligible_system_ids":{"type":"array","items":{"type":"string"}},"point_frontier_system_ids":{"type":"array","items":{"type":"string"}},
        "dominated_by":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}},
        "threshold_aware_frontier":{"anyOf":[{"type":"null"},{"type":"object","required":["threshold_evidence_refs","frontier_system_ids"],"properties":{"threshold_evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"frontier_system_ids":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}]}
      }
    },
    "stat_result": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","baseline_id","metric_id","estimand","n_pairs","n_source_groups","method","estimate","ci","raw_p","adjusted_p","statistical_direction","practical_materiality"],
      "properties": {
        "candidate_id":{"type":"string"},"baseline_id":{"type":"string"},"metric_id":{"type":"string"},"estimand":{"type":"string"},"n_pairs":{"type":"integer","minimum":0},"n_source_groups":{"type":"integer","minimum":0},"method":{"type":"string"},
        "estimate":{"type":["number","null"]},"ci":{"type":["array","null"],"items":{"type":"number"},"minItems":2,"maxItems":2},"raw_p":{"type":["number","null"],"minimum":0,"maximum":1},"adjusted_p":{"type":["number","null"],"minimum":0,"maximum":1},
        "statistical_direction":{"enum":["FAVORS_CANDIDATE","FAVORS_BASELINE","INCONCLUSIVE","NOT_COMPUTABLE","NOT_APPLICABLE"]},
        "practical_materiality":{"enum":["EVIDENCE_SUPPORTED_MATERIAL","EVIDENCE_SUPPORTED_NEGLIGIBLE","PENDING_EVIDENCE","NOT_COMPUTABLE","NOT_APPLICABLE"]},
        "materiality_evidence_refs":{"type":"array","items":{"type":"string"}}
      }
    },
    "utility": {
      "type":"object","additionalProperties":false,"required":["status","evidence_refs","sensitivity"],
      "properties":{"status":{"enum":["PENDING_EVIDENCE","NO_PREFERENCE","EVIDENCE_SUPPORTED"]},"weights":{"type":["object","null"],"additionalProperties":{"type":"number","minimum":0}},"thresholds":{"type":["object","null"],"additionalProperties":{"type":"number"}},"evidence_refs":{"type":"array","items":{"type":"string"}},"sensitivity":{"type":"object","required":["parameter_ranges","preferred_set_stable"],"properties":{"parameter_ranges":{"type":"object"},"preferred_set_stable":{"type":"boolean"},"preferred_set":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}}
    },
    "decision": {
      "type":"object","additionalProperties":false,"required":["status","preferred_system_ids","reason"],
      "properties":{"status":{"enum":["PREFERENCE_SUPPORTED","NO_PREFERENCE","PENDING_EVIDENCE","ALL_INELIGIBLE"]},"preferred_system_ids":{"type":"array","items":{"type":"string"}},"reason":{"type":"string","minLength":1}}
    },
    "provenance": {
      "type":"object","additionalProperties":false,"required":["repository_commit_sha","benchmark_manifest_version","methodology_id","random_seeds","input_artifact_hashes","created_at_utc"],
      "properties":{"repository_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"benchmark_manifest_version":{"type":"string","minLength":1},"methodology_id":{"const":"W005-BENCHMARK-METHODOLOGY-V002"},"rubric_or_evaluator_versions":{"type":"array","items":{"type":"string"}},"pricing_snapshot_id":{"type":["string","null"]},"random_seeds":{"type":"array","items":{"type":"integer"}},"input_artifact_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"created_at_utc":{"type":"string","format":"date-time"}}
    }
  }
}
